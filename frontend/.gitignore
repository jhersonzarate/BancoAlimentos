```gitignore id="e7uk0u"
# =========================
# ANGULAR FRONTEND
# =========================

# Dependencies
/node_modules

# Angular build
/dist
/.angular
/.angular/cache
/out-tsc

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Environment files
src/environments/environment*.ts

# Coverage
/coverage

# IDEs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

.idea/
*.iml
.project
.classpath
.settings/

# OS files
.DS_Store
Thumbs.db

# =========================
# SPRING BOOT BACKEND
# =========================

# Maven
/target/
.mvn/wrapper/maven-wrapper.jar

# Gradle
/build/
.gradle/

# Java
*.class
*.jar
*.war
*.ear

# Spring Boot logs
*.log
logs/

# Application secrets
application-local.properties
application-prod.properties
.env

# Database
*.db
*.mv.db
*.trace.db

# Metals / Scala
.metals/
.bloop/

# IntelliJ
.idea/
*.iws
*.ipr

# VS Code
.vscode/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Eclipse
.apt_generated
.factorypath
.springBeans
.sts4-cache

# Mac / Windows
.DS_Store
Thumbs.db
